rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public, read-only aggregate stats for the pre-login welcome screen.
    // Maintained only by Cloud Functions (Admin SDK bypasses these rules),
    // so this stays the ONE thing a signed-out client can read — never the
    // underlying users/donation_logs/organization_profiles collections,
    // which contain personal data.
    match /stats/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Authenticated access for all other collections.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
